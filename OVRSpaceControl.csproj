<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OVR Space Control</AssemblyName>
    <Product>OVR Space Control</Product>
    <FileDescription>OVR Space Control</FileDescription>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>SteamVR\OVR Space Control.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);Build/**;Build2/**;GitHub-upload/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(ApplicationIcon)" LogicalName="AppIcon.ico" />
    <None Update="SteamVR\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
